{
  "info": {
    "name": "Shop Nexus Core API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual end-to-end collection for Shop Nexus Core microservices. It covers health checks, auth, catalog, orders, recommendations, notification health, and RAG endpoints."
  },
  "item": [
    {
      "name": "System Flow",
      "description": "Run these requests in order to exercise the main happy path across the microservices.",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload.id) { pm.collectionVariables.set('user_id', payload.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Request-ID", "value": "{{request_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone_number\": \"+1234567890\",\n  \"password\": \"secret123\",\n  \"roles\": [\"user\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{auth_base_url}}/auth/register",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "2. Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload.token) { pm.collectionVariables.set('jwt_token', payload.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Request-ID", "value": "{{request_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{auth_base_url}}/auth/login",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "3. Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload.id) { pm.collectionVariables.set('category_id', payload.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Request-ID", "value": "{{request_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{product_base_url}}/categories",
              "host": ["{{product_base_url}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "4. Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload.id) { pm.collectionVariables.set('product_id', payload.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Request-ID", "value": "{{request_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gaming Laptop\",\n  \"description\": \"RTX 4080, 32GB RAM\",\n  \"price\": 1500.99,\n  \"category_ids\": [\"{{category_id}}\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{product_base_url}}/products",
              "host": ["{{product_base_url}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "5. Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload.ID) { pm.collectionVariables.set('order_id', payload.ID); }",
                  "if (payload.UserID) { pm.collectionVariables.set('user_id', payload.UserID); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Request-ID", "value": "{{request_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 2,\n      \"price\": 1500.99\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{order_base_url}}/orders",
              "host": ["{{order_base_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "6. Train Recommendation Model",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload.artifact_id) { pm.collectionVariables.set('artifact_id', payload.artifact_id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Request-ID", "value": "{{request_id}}" }
            ],
            "url": {
              "raw": "{{recommendation_base_url}}/recommendations/train",
              "host": ["{{recommendation_base_url}}"],
              "path": ["recommendations", "train"]
            }
          }
        },
        {
          "name": "7. Get Recommendations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Request-ID", "value": "{{request_id}}" }
            ],
            "url": {
              "raw": "{{recommendation_base_url}}/recommendations/{{user_id}}?limit=5",
              "host": ["{{recommendation_base_url}}"],
              "path": ["recommendations", "{{user_id}}"],
              "query": [
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "8. Index Catalog for RAG",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Request-ID", "value": "{{request_id}}" }
            ],
            "url": {
              "raw": "{{rag_base_url}}/catalog/index",
              "host": ["{{rag_base_url}}"],
              "path": ["catalog", "index"]
            }
          }
        },
        {
          "name": "9. Query RAG",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Request-ID", "value": "{{request_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Which products are good for gaming?\",\n  \"top_k\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rag_base_url}}/rag/query",
              "host": ["{{rag_base_url}}"],
              "path": ["rag", "query"]
            }
          }
        }
      ]
    },
