# Shared infrastructure for the full Docker Compose stack.
MONGODB_URI=mongodb://mongo:27017
DB_NAME=shop-nexus-core
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672/
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672/
CELERY_RESULT_BACKEND=rpc://

# Shared HTTP and authentication settings.
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT=100-M
TOKEN_EXPIRATION=24h

# Shared event contract settings.
ORDER_EVENTS_EXCHANGE=order_created
ORDER_EVENTS_QUEUE=order_created
ORDER_EVENTS_ROUTING_KEY=order_created

# Notification service settings.
LOG_LEVEL=INFO
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HEARTBEAT=600
RABBITMQ_RETRY_DELAY=5
RABBITMQ_MAX_RETRIES=10
NOTIFICATION_EMAIL_DOMAIN=example.com
NOTIFICATION_PHONE_DEFAULT=+1234567890

# Recommendation service settings.
TRAIN_INTERVAL=10
MODEL_PATH=/app/model/model.joblib
MODEL_REGISTRY_DIR=/app/model/artifacts
MODEL_VERSIONS_TO_KEEP=5
MODEL_FACTORS=32
MODEL_ITERATIONS=20
MODEL_REGULARIZATION=0.1
MODEL_ALPHA=20
POPULAR_FALLBACK_SIZE=20
EVALUATION_TOP_K=10
MONGO_MAX_POOL_SIZE=50
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000

# RAG service settings.
RAG_PORT=8005
CHROMA_PERSIST_DIRECTORY=/app/chroma
CHROMA_COLLECTION_NAME=catalog
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://shop-nexus-core.local
OPENROUTER_APP_NAME=shop-nexus-core